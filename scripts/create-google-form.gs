/**
 * สร้างแบบสอบถามของโครงงาน Focus Pet ใน Google Forms อัตโนมัติ
 * =============================================================
 *
 * วิธีใช้ (ทำครั้งเดียว ใช้เวลาประมาณ 2 นาที)
 *
 *   1. เปิด https://script.google.com แล้วกด "New project"
 *   2. ลบโค้ดตัวอย่างออก แล้ววางไฟล์นี้ทั้งไฟล์ลงไป
 *   3. กด Save (ไอคอนแผ่นดิสก์)
 *   4. เลือกฟังก์ชัน createFocusPetForm จากเมนูด้านบน แล้วกด Run
 *   5. ครั้งแรกจะขึ้นขออนุญาต ให้กด Review permissions แล้วอนุญาต
 *      (จะขึ้นเตือนว่า "Google hasn't verified this app" เป็นเรื่องปกติ
 *       เพราะเป็นสคริปต์ที่เราเขียนเอง กด Advanced แล้ว Go to ... ต่อได้)
 *   6. ดูผลลัพธ์ที่หน้าต่าง Execution log ด้านล่าง
 *      จะมีลิงก์ฟอร์ม ลิงก์ชีต และ PREFILL URL ที่ทีมพัฒนาต้องใช้
 *
 * สคริปต์นี้จะสร้างให้ทั้งหมด
 *   • ฟอร์ม 5 ตอน พร้อมหัวข้อและคำอธิบาย
 *   • ช่องรหัสผู้เข้าร่วม พร้อมตรวจรูปแบบอัตโนมัติ (regex)
 *   • ช่องเลือกรอบการตอบ (ก่อน / หลัง การทดลอง)
 *   • ข้อมูลทั่วไป และแบบประเมินความพึงพอใจ 9 ข้อ ตามข้อเสนอโครงงาน
 *   • โครงของ SAS-SV และ PSQI พร้อมมาตรวัดที่ถูกต้อง
 *   • Google Sheet สำหรับเก็บคำตอบ
 *
 * ⚠️ อ่านหัวข้อ "สิ่งที่ต้องแก้ก่อนใช้จริง" ที่ท้ายไฟล์ก่อนเก็บข้อมูล
 */

// ---------------------------------------------------------------------------
// ค่าคงที่
// ---------------------------------------------------------------------------

var FORM_TITLE = 'แบบสอบถามโครงงาน Focus Pet'

var FORM_DESCRIPTION = [
  'แบบสอบถามนี้เป็นส่วนหนึ่งของโครงงาน "แอปพลิเคชันเปลี่ยนเวลาที่ไม่ใช้หน้าจอเป็นความก้าวหน้าในเกม"',
  'สาขาวิชาวิทยาการคอมพิวเตอร์ วิทยาลัยการคอมพิวเตอร์',
  '',
  'คำตอบของท่านจะถูกนำไปใช้เพื่อการวิเคราะห์ผลการวิจัยเท่านั้น',
  'และจะรายงานผลในภาพรวมโดยไม่ระบุตัวบุคคล',
  '',
  'แบบสอบถามใช้เวลาประมาณ 10–15 นาที',
].join('\n')

/**
 * รูปแบบรหัสผู้เข้าร่วมที่แอปออกให้ เช่น FP-K7M2N
 * ชุดตัวอักษรตัด I L O U 0 1 ออก เพราะสับสนกันง่ายเมื่อเขียนด้วยลายมือ
 * ตรงกับ generateParticipantId() ใน web/src/lib/consent.ts
 */
var CODE_PATTERN = '^FP-[2-9A-HJKMNP-TV-Z]{5}$'

/** มาตรวัดความถี่ 4 ระดับ ใช้กับ PSQI ข้อ 5 */
var PSQI_FREQUENCY = [
  'ไม่เคยเลยในเดือนที่ผ่านมา',
  'น้อยกว่า 1 ครั้งต่อสัปดาห์',
  '1–2 ครั้งต่อสัปดาห์',
  '3 ครั้งขึ้นไปต่อสัปดาห์',
]

// ---------------------------------------------------------------------------
// ฟังก์ชันหลัก
// ---------------------------------------------------------------------------

function createFocusPetForm() {
  var form = FormApp.create(FORM_TITLE)
  form.setDescription(FORM_DESCRIPTION)
  form.setProgressBar(true)
  form.setShowLinkToRespondAgain(false)

  // ไม่เก็บอีเมล และไม่จำกัดการตอบหนึ่งครั้งต่อบัญชี
  // เหตุผล: หนังสือยินยอมระบุว่าข้อมูลวิเคราะห์จะไม่มีอีเมล และผู้เข้าร่วม
  // ต้องตอบได้สองรอบ (ก่อนและหลังการทดลอง) เพื่อทำ paired t-test
  trySet(function () {
    form.setCollectEmail(false)
  })
  trySet(function () {
    form.setLimitOneResponsePerUser(false)
  })
  trySet(function () {
    form.setRequireLogin(false)
  })

  var codeItem = buildSectionIdentity(form)
  buildSectionDemographics(form)
  buildSectionSasSv(form)
  buildSectionPsqi(form)
  buildSectionSatisfaction(form)

  // สร้างชีตเก็บคำตอบ
  var sheet = SpreadsheetApp.create(FORM_TITLE + ' (คำตอบ)')
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId())

  // ลิงก์ที่เติมรหัสไว้แล้ว ทีมพัฒนาต้องใช้เลข entry.xxxxx จากลิงก์นี้
  var prefillUrl = form
    .createResponse()
    .withItemResponse(codeItem.createResponse('FP-TEST1'))
    .toPrefilledUrl()

  Logger.log('')
  Logger.log('=====================================================')
  Logger.log('  สร้างฟอร์มเรียบร้อยแล้ว')
  Logger.log('=====================================================')
  Logger.log('')
  Logger.log('ลิงก์สำหรับผู้เข้าร่วม (ส่งลิงก์นี้ให้ผู้ตอบ):')
  Logger.log(form.getPublishedUrl())
  Logger.log('')
  Logger.log('ลิงก์สำหรับแก้ไขฟอร์ม (เก็บไว้ในทีม):')
  Logger.log(form.getEditUrl())
  Logger.log('')
  Logger.log('ชีตเก็บคำตอบ:')
  Logger.log(sheet.getUrl())
  Logger.log('')
  Logger.log('>>> ส่งบรรทัดล่างนี้ให้ทีมพัฒนา เพื่อทำปุ่มเปิดฟอร์มในแอป <<<')
  Logger.log('PREFILL URL:')
  Logger.log(prefillUrl)
  Logger.log('')
  Logger.log('อย่าลืมอ่านหัวข้อ "สิ่งที่ต้องแก้ก่อนใช้จริง" ท้ายไฟล์สคริปต์')
  Logger.log('=====================================================')

  return form.getEditUrl()
}

// ---------------------------------------------------------------------------
// ตอนที่ 1 — รหัสผู้เข้าร่วมและรอบการตอบ
// ---------------------------------------------------------------------------

function buildSectionIdentity(form) {
  form
    .addSectionHeaderItem()
    .setTitle('ตอนที่ 1 — ข้อมูลการตอบ')
    .setHelpText('ส่วนนี้ใช้จับคู่คำตอบของท่านกับข้อมูลในแอป โดยไม่ต้องเปิดเผยชื่อจริง')

  // ช่องรหัส ต้องเป็นรายการแรกเพื่อให้ pre-filled link ทำงานสะดวก
  var codeItem = form
    .addTextItem()
    .setTitle('รหัสผู้เข้าร่วม')
    .setHelpText(
      'เปิดแอป Focus Pet → หน้าตั้งค่า → คัดลอกรหัส (ตัวอย่าง FP-K7M2N)\n' +
        'หากท่านเปิดแบบสอบถามจากปุ่มในแอป ช่องนี้จะถูกกรอกให้อัตโนมัติแล้ว',
    )
    .setRequired(true)

  codeItem.setValidation(
    FormApp.createTextValidation()
      .setHelpText('รหัสต้องอยู่ในรูปแบบ FP-XXXXX เช่น FP-K7M2N (ดูได้ในหน้าตั้งค่าของแอป)')
      .requireTextMatchesPattern(CODE_PATTERN)
      .build(),
  )

  // จำเป็นสำหรับ paired t-test: ถ้าไม่รู้ว่าคำตอบนี้เป็นรอบก่อนหรือหลัง
  // ก็จับคู่ก่อน-หลังของคนเดียวกันไม่ได้ แม้จะมีรหัสถูกต้องก็ตาม
  form
    .addMultipleChoiceItem()
    .setTitle('รอบการตอบแบบสอบถาม')
    .setHelpText('เลือกให้ตรงกับรอบที่ทีมวิจัยแจ้ง')
    .setChoiceValues([
      'ก่อนเริ่มใช้แอป (Pre-test)',
      'หลังใช้แอปครบ 4 สัปดาห์ (Post-test)',
    ])
    .setRequired(true)

  return codeItem
}

// ---------------------------------------------------------------------------
// ตอนที่ 2 — ข้อมูลทั่วไป (ตามภาคผนวกของข้อเสนอโครงงาน)
// ---------------------------------------------------------------------------

function buildSectionDemographics(form) {
  form.addPageBreakItem().setTitle('ตอนที่ 2 — ข้อมูลทั่วไป')

  form
    .addMultipleChoiceItem()
    .setTitle('เพศ')
    .setChoiceValues(['ชาย', 'หญิง'])
    .showOtherOption(true)
    .setRequired(true)

  form
    .addMultipleChoiceItem()
    .setTitle('อายุ')
    .setChoiceValues(['ต่ำกว่า 15 ปี', '15–20 ปี', '21–25 ปี', '26–30 ปี', 'มากกว่า 30 ปี'])
    .setRequired(true)

  form
    .addMultipleChoiceItem()
    .setTitle('ระยะเวลาการใช้งานหน้าจอโดยเฉลี่ยต่อวัน (ก่อนใช้แอปพลิเคชัน)')
    .setChoiceValues([
      'น้อยกว่า 3 ชั่วโมง',
      '3–5 ชั่วโมง',
      '5–8 ชั่วโมง',
      'มากกว่า 8 ชั่วโมง',
    ])
    .setRequired(true)

  form
    .addMultipleChoiceItem()
    .setTitle('วัตถุประสงค์หลักในการใช้สมาร์ตโฟน')
    .setChoiceValues(['การเรียน', 'ความบันเทิง', 'การติดต่อสื่อสาร', 'โซเชียลมีเดีย'])
    .showOtherOption(true)
    .setRequired(true)
}

// ---------------------------------------------------------------------------
// ตอนที่ 3 — SAS-SV
// ---------------------------------------------------------------------------

/**
 * Smartphone Addiction Scale – Short Version (Kwon et al., 2013)
 * 10 ข้อ มาตรวัด 6 ระดับ
 *
 * ⚠️ ข้อความด้านล่างเป็น "ฉบับร่างเพื่อวางโครง" ไม่ใช่ฉบับแปลไทยที่ผ่านการตรวจสอบ
 * ต้องแทนที่ด้วยฉบับแปลไทยมาตรฐานก่อนเก็บข้อมูลจริง — ดูหมายเหตุท้ายไฟล์
 */
var SAS_SV_ITEMS = [
  'การใช้สมาร์ตโฟนทำให้ข้าพเจ้าทำงานหรือการบ้านที่วางแผนไว้ไม่สำเร็จ',
  'ข้าพเจ้ามีปัญหาในการมีสมาธิระหว่างเรียน ทำงาน หรือทำกิจกรรมอื่น เพราะใช้สมาร์ตโฟน',
  'ข้าพเจ้ารู้สึกเจ็บข้อมือหรือต้นคอขณะใช้สมาร์ตโฟน',
  'ข้าพเจ้าทนไม่ได้ถ้าไม่มีสมาร์ตโฟนอยู่กับตัว',
  'ข้าพเจ้ารู้สึกหงุดหงิดหรือกระวนกระวายเมื่อไม่ได้ถือสมาร์ตโฟน',
  'ข้าพเจ้าคิดถึงสมาร์ตโฟนอยู่ตลอดแม้ในขณะที่ไม่ได้ใช้',
  'ข้าพเจ้าจะไม่มีวันเลิกใช้สมาร์ตโฟน แม้ว่ามันจะรบกวนชีวิตประจำวันมากก็ตาม',
  'ข้าพเจ้าคอยเช็กสมาร์ตโฟนอยู่เสมอเพื่อไม่ให้พลาดบทสนทนาบนโซเชียลมีเดีย',
  'ข้าพเจ้าใช้สมาร์ตโฟนนานกว่าที่ตั้งใจไว้',
  'คนรอบตัวบอกข้าพเจ้าว่าใช้สมาร์ตโฟนมากเกินไป',
]

function buildSectionSasSv(form) {
  form
    .addPageBreakItem()
    .setTitle('ตอนที่ 3 — พฤติกรรมการใช้สมาร์ตโฟน')
    .setHelpText(
      'โปรดเลือกระดับที่ตรงกับตัวท่านมากที่สุด\n' +
        '1 = ไม่เห็นด้วยอย่างยิ่ง   6 = เห็นด้วยอย่างยิ่ง',
    )

  for (var i = 0; i < SAS_SV_ITEMS.length; i++) {
    form
      .addScaleItem()
      .setTitle(i + 1 + '. ' + SAS_SV_ITEMS[i])
      .setBounds(1, 6)
      .setLabels('ไม่เห็นด้วยอย่างยิ่ง', 'เห็นด้วยอย่างยิ่ง')
      .setRequired(true)
  }
}

// ---------------------------------------------------------------------------
// ตอนที่ 4 — PSQI
// ---------------------------------------------------------------------------

/**
 * Pittsburgh Sleep Quality Index (Buysse et al., 1989)
 * 19 ข้อ รูปแบบคำตอบผสมกัน จึงสร้างทีละข้อ
 *
 * ⚠️ เช่นเดียวกับ SAS-SV ข้อความเป็นฉบับร่างเพื่อวางโครง
 * ต้องแทนที่ด้วยฉบับแปลไทยที่ผ่านการตรวจสอบก่อนใช้จริง
 */
var PSQI_DISTURBANCE_ITEMS = [
  'ก. ไม่สามารถนอนหลับได้ภายใน 30 นาที',
  'ข. ตื่นกลางดึกหรือตื่นเช้ากว่าปกติ',
  'ค. ต้องลุกไปเข้าห้องน้ำ',
  'ง. หายใจไม่สะดวก',
  'จ. ไอหรือกรนเสียงดัง',
  'ฉ. รู้สึกหนาวเกินไป',
  'ช. รู้สึกร้อนเกินไป',
  'ซ. ฝันร้าย',
  'ฌ. มีอาการเจ็บปวด',
  'ญ. สาเหตุอื่น ๆ',
]

function buildSectionPsqi(form) {
  form
    .addPageBreakItem()
    .setTitle('ตอนที่ 4 — คุณภาพการนอนหลับ')
    .setHelpText('คำถามต่อไปนี้เกี่ยวกับการนอนหลับของท่าน "ในช่วง 1 เดือนที่ผ่านมา"')

  form
    .addTextItem()
    .setTitle('1. โดยปกติท่านเข้านอนเวลาใด')
    .setHelpText('ตอบเป็นเวลา เช่น 23:30')
    .setRequired(true)

  form
    .addTextItem()
    .setTitle('2. ท่านใช้เวลานานเท่าใด (เป็นนาที) จึงจะหลับได้ในแต่ละคืน')
    .setHelpText('ตอบเป็นตัวเลข เช่น 20')
    .setRequired(true)

  form
    .addTextItem()
    .setTitle('3. โดยปกติท่านตื่นนอนตอนเช้าเวลาใด')
    .setHelpText('ตอบเป็นเวลา เช่น 07:00')
    .setRequired(true)

  form
    .addTextItem()
    .setTitle('4. ท่านนอนหลับจริง ๆ คืนละกี่ชั่วโมง')
    .setHelpText('อาจไม่เท่ากับจำนวนชั่วโมงที่อยู่บนเตียง ตอบเป็นตัวเลข เช่น 6.5')
    .setRequired(true)

  form
    .addSectionHeaderItem()
    .setTitle('5. ในช่วง 1 เดือนที่ผ่านมา ท่านนอนหลับไม่ดีเพราะสาเหตุต่อไปนี้บ่อยเพียงใด')

  for (var i = 0; i < PSQI_DISTURBANCE_ITEMS.length; i++) {
    form
      .addMultipleChoiceItem()
      .setTitle('5' + PSQI_DISTURBANCE_ITEMS[i])
      .setChoiceValues(PSQI_FREQUENCY)
      .setRequired(true)
  }

  form
    .addMultipleChoiceItem()
    .setTitle('6. ท่านประเมินคุณภาพการนอนหลับโดยรวมของตนเองอย่างไร')
    .setChoiceValues(['ดีมาก', 'ค่อนข้างดี', 'ค่อนข้างแย่', 'แย่มาก'])
    .setRequired(true)

  form
    .addMultipleChoiceItem()
    .setTitle('7. ท่านใช้ยานอนหลับ (ทั้งที่แพทย์สั่งและซื้อเอง) บ่อยเพียงใด')
    .setChoiceValues(PSQI_FREQUENCY)
    .setRequired(true)

  form
    .addMultipleChoiceItem()
    .setTitle('8. ท่านมีปัญหาง่วงนอนขณะขับรถ รับประทานอาหาร หรือทำกิจกรรมทางสังคมบ่อยเพียงใด')
    .setChoiceValues(PSQI_FREQUENCY)
    .setRequired(true)

  form
    .addMultipleChoiceItem()
    .setTitle('9. ท่านมีปัญหาในการรักษาความกระตือรือร้นเพื่อทำสิ่งต่าง ๆ ให้สำเร็จมากน้อยเพียงใด')
    .setChoiceValues([
      'ไม่มีปัญหาเลย',
      'มีปัญหาเล็กน้อย',
      'มีปัญหาพอสมควร',
      'มีปัญหามาก',
    ])
    .setRequired(true)
}

// ---------------------------------------------------------------------------
// ตอนที่ 5 — ความพึงพอใจ (ตามภาคผนวกของข้อเสนอโครงงาน)
// ---------------------------------------------------------------------------

var SATISFACTION_ITEMS = [
  'การใช้งานแอปพลิเคชัน (เช่น การสมัครสมาชิก การดูสถานะสัตว์เลี้ยง) มีความง่ายและเข้าใจได้เพียงใด',
  'ระบบติดตามระยะเวลาปลอดหน้าจอมีความถูกต้องและแม่นยำมากน้อยเพียงใด',
  'ท่านพึงพอใจกับกลไกการเจริญเติบโตของสัตว์เลี้ยงเสมือนมากน้อยเพียงใด',
  'ท่านคิดว่าระบบช่วยกระตุ้นแรงจูงใจให้ลดระยะเวลาการใช้งานหน้าจอได้มากน้อยเพียงใด',
  'ท่านพึงพอใจกับการแจ้งเตือน (Notification) ของแอปพลิเคชันมากน้อยเพียงใด',
  'ท่านพึงพอใจกับความสวยงามและภาพเคลื่อนไหวของสัตว์เลี้ยงเสมือนมากน้อยเพียงใด',
  'ท่านคิดว่าแอปพลิเคชันนี้ช่วยให้คุณภาพการนอนหลับของท่านดีขึ้นมากน้อยเพียงใด',
  'ท่านมีแนวโน้มที่จะใช้งานแอปพลิเคชันนี้ต่อเนื่องในระยะยาวมากน้อยเพียงใด',
  'โดยรวมแล้ว ท่านมีความพึงพอใจต่อแอปพลิเคชันนี้ในระดับใด',
]

function buildSectionSatisfaction(form) {
  // ตอนนี้ตอบได้เฉพาะรอบหลังการทดลอง เพราะยังไม่ได้ใช้แอปตอน pre-test
  form
    .addPageBreakItem()
    .setTitle('ตอนที่ 5 — ความพึงพอใจต่อแอปพลิเคชัน')
    .setHelpText(
      'ส่วนนี้ตอบเฉพาะรอบหลังการทดลองเท่านั้น หากท่านกำลังตอบรอบก่อนเริ่มใช้แอป ให้ข้ามไปส่งแบบสอบถามได้เลย\n\n' +
        '5 = พึงพอใจมากที่สุด   1 = พึงพอใจน้อยที่สุด',
    )

  for (var i = 0; i < SATISFACTION_ITEMS.length; i++) {
    form
      .addScaleItem()
      .setTitle(i + 1 + '. ' + SATISFACTION_ITEMS[i])
      .setBounds(1, 5)
      .setLabels('พึงพอใจน้อยที่สุด', 'พึงพอใจมากที่สุด')
      .setRequired(false)
  }

  form.addParagraphTextItem().setTitle('ข้อเสนอแนะเพิ่มเติม').setRequired(false)
}

