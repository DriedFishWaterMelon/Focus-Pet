/**
 * เรียกฟังก์ชันตั้งค่าที่อาจไม่รองรับในบัญชีบางประเภท
 * เช่น setRequireLogin ใช้ได้เฉพาะบัญชี Google Workspace
 * ถ้าไม่รองรับก็ข้ามไป ไม่ต้องให้สคริปต์ทั้งตัวล้ม
 */
function trySet(fn) {
  try {
    fn()
  } catch (e) {
    Logger.log('ข้ามการตั้งค่าหนึ่งรายการ (บัญชีนี้ไม่รองรับ): ' + e.message)
  }
}

