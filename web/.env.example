# Firebase web config. Copy this file to .env and fill in from
# Firebase Console > Project settings > Your apps > Web app.
# These are shipped to the browser and are not secrets; access is
# controlled by firestore.rules, not by hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# ปล่อยว่างได้ ระบบแจ้งเตือนจะปิดตัวเองอย่างเงียบ ๆ
VITE_FIREBASE_VAPID_KEY=
